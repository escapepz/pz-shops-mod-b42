{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "disable": [
      "undefined-field",
      "inject-field",
      "redundant-parameter"
    ]
  },
  "workspace": {
    "ignoreDir": [
      ".git",
      ".vscode",
      ".serena",
      ".libraries",
      "docs",
      "build",
      "Logs",
      "ShopsHooksExample",
      "node_modules",
      "temp_dir",
      "tmp"
    ],
    "library": [
      ".libraries"
    ]
  }
}